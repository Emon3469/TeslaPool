# ==============================================================================
# TeslaPool Production & Local Environment Configuration
# ==============================================================================
# Copy this file to .env before running docker compose:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMAIN & NETWORKING (VPS / Caddy)
# ------------------------------------------------------------------------------
# Your public production domain. Caddy will automatically issue a free Let's Encrypt SSL certificate for this domain.
# For local testing, keep "localhost".
DOMAIN=localhost

# Frontend URL accessed by users (used in emails & links)
APP_URL=http://localhost:3000

# Comma-separated list of allowed browser origins for CORS & CSRF checks.
# MUST match your frontend domain in production (e.g., https://teslapool.example.com).
# Production rejects wildcard "*".
CORS_ORIGINS=http://localhost:3000

# Number of proxies in front of the backend, so rate limits see the real client IP:
#   1 = local docker compose (browser -> Next.js -> API)
#   2 = VPS with Caddy (Caddy -> Next.js -> API; set in docker-compose.prod.yml) or Vercel + Render
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=teslapool
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD_IN_PRODUCTION
POSTGRES_DB=teslapool
POSTGRES_HOST_PORT=5432

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Mandatory JWT secret (minimum 32 random characters).
# Generate using: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Browser session cookie SameSite setting ("lax" when frontend proxies to backend, "none" if cross-domain)
AUTH_COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 4. INITIALIZATION & SEED DATA
# ------------------------------------------------------------------------------
# Run Prisma database migrations on container startup (true by default)
RUN_MIGRATIONS=true

# Seed demo accounts and test vehicles on startup (true for demo/staging, false for production)
SEED_ON_START=true

# Demo passwords if SEED_ON_START=true
SEED_PASSENGER_PASSWORD=Passenger@2026
SEED_DRIVER_PASSWORD=Driver@2026
SEED_ADMIN_PASSWORD=Admin@2026

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATIONS (Brevo / Transactional)
# ------------------------------------------------------------------------------
# "required" (sign-ups confirm a 6-digit emailed code before booking/driving), "optional", or "off" (no codes).
# "required"/"optional" need BREVO_API_KEY + BREVO_SENDER_EMAIL; without them the API logs a warning and runs with it off.
EMAIL_VERIFICATION=off
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TeslaPool

# ------------------------------------------------------------------------------
# 6. PORTS & LOGGING
# ------------------------------------------------------------------------------
WEB_HOST_PORT=3000
API_HOST_PORT=4000
ML_HOST_PORT=8000
LOG_LEVEL=info
