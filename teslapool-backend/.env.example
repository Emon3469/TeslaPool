# ── TeslaPool API configuration ─────────────────────────────────────────────
# Copy to .env for local development. NEVER commit .env. All values are validated at startup.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info                 # error | warn | info | http | debug | silent
TRUST_PROXY=0                  # set 1 behind Render / a single reverse proxy (correct client IPs for rate limiting)

# PostgreSQL. Tests use an isolated "teslapool_test" schema in this database (or TEST_DATABASE_URL).
DATABASE_URL=postgresql://teslapool:CHANGE_ME@localhost:5432/teslapool
# TEST_DATABASE_URL= (optional; default: same database, schema "teslapool_test")
DB_TX_TIMEOUT_MS=10000
DB_TX_MAX_WAIT_MS=10000

# JWT (HS256). REQUIRED in production: at least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=1h
JWT_ISSUER=teslapool-api
JWT_AUDIENCE=teslapool-clients

# Comma-separated list of allowed browser origins. "*" is rejected in production.
CORS_ORIGINS=http://localhost:3000

# Rate limiting (in-memory, per instance)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300             # all /api/v1 requests per IP per window
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20         # login + register per IP per 15 min
RIDE_RATE_LIMIT_MAX=30         # ride creation + match per user per window
PREDICTION_RATE_LIMIT_MAX=60   # prediction calls per user per window
IDEMPOTENCY_TTL_HOURS=24

# ── Pool engine: hard constraints ───────────────────────────────────────────
POOL_MAX_CAPACITY=3
PICKUP_MAX_HOPS=1
DESTINATION_MAX_HOPS=2
MAX_DETOUR_KM=1.5              # allowed detour = max(MAX_DETOUR_KM, MAX_DETOUR_RATIO x solo distance)
MAX_DETOUR_RATIO=0.30
MAX_STOPS=4
ALLOW_LATE_JOIN=false          # joining after DRIVER_ARRIVED
MATCH_CANDIDATE_LIMIT=50

# Route scoring weights (lower score = better; applied only after hard constraints pass)
SCORE_WEIGHT_DISTANCE=0.35
SCORE_WEIGHT_DETOUR=0.25
SCORE_WEIGHT_STOPS=0.15
SCORE_WEIGHT_TIME_VARIANCE=0.10
SCORE_WEIGHT_SHARING=0.15

# ── Fare engine (integer poysha; 1 BDT = 100 poysha) ────────────────────────
FARE_BASE_POYSHA=5000
FARE_PER_KM_POYSHA=2000
FARE_PER_MIN_POYSHA=50
FARE_POOL_ALPHA=0.25
FARE_MAX_DISCOUNT=0.25
ML_FARE_MAX_DEVIATION=0.20     # ML fare band around the deterministic baseline (±20%)
FARE_PRICING_MODE=deterministic  # deterministic (default, hand-verifiable) | ml_guarded (ML may price inside the band)

# Deterministic ETA fallback (minutes per km by traffic; medians of the training data)
ETA_MIN_PER_KM_LOW=3.3
ETA_MIN_PER_KM_MEDIUM=5.0
ETA_MIN_PER_KM_HIGH=7.5
ETA_MIN_PER_KM_GRIDLOCK=12.0
ETA_ML_MIN_RATIO=0.5           # ML ETA accepted only within [0.5x, 2.0x] of the deterministic ETA
ETA_ML_MAX_RATIO=2.0

# Server-side request context
DEFAULT_VEHICLE_TYPE=AUTO_RICKSHAW  # AUTO_RICKSHAW (the PRD's "Tesla") | RICKSHAW | BIKE_RIDESHARE
DEFAULT_WEATHER=CLEAR
SURGE_MULTIPLIER=1.0           # platform-controlled; clients cannot set surge

# ── ML sidecar (optional) ───────────────────────────────────────────────────
# Leave empty to run fully deterministic. Local sidecar: cd ml/inference && uvicorn app:app --port 8000
ML_SIDECAR_URL=
ML_TIMEOUT_MS=1500
ML_COOLDOWN_MS=30000           # circuit breaker: skip ML for this long after a failure

# ── Container start (scripts/docker-entrypoint.sh) ──────────────────────────
RUN_MIGRATIONS=true
SEED_ON_START=false            # demo accounts; enable only for demo environments

# ── Demo accounts (seed re-applies these to the story cast on every run) ─────
SEED_PASSENGER_PASSWORD=Passenger@2026   # nusrat@, rafiq@, shirin@teslapool.dev
SEED_DRIVER_PASSWORD=Driver@2026         # jashim@teslapool.dev
SEED_ADMIN_PASSWORD=Admin@2026           # ops@teslapool.dev
# SEED_PASSWORD=                         # optional shared fallback for all three (min 8 chars)

# ── Email: verification codes and password reset (Brevo transactional) ──────
BREVO_API_KEY=                 # Brevo → SMTP & API → API keys (starts with xkeysib-). Empty = codes go to the dev log.
BREVO_SENDER_EMAIL=            # a sender verified in Brevo (Senders, domains & dedicated IPs)
BREVO_SENDER_NAME=TeslaPool
EMAIL_VERIFICATION=required    # required: book/drive/top-up after confirming the code · optional · off
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_SECONDS=60
APP_URL=http://localhost:3000  # frontend base URL used in email links

# ── Browser session cookie (HttpOnly JWT; Bearer tokens always work too) ────
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_NAME=tp_session
AUTH_COOKIE_SAMESITE=lax       # use "none" when frontend and API are on different sites (forces Secure)
# AUTH_COOKIE_SECURE=          # default: true in production
