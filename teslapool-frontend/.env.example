# Where the Next.js server proxies /api/v1/* (the TeslaPool API). Server-side only.
BACKEND_URL=http://localhost:4000
# Also needed at BUILD time (Next.js bakes the /api/v1 rewrite into the build). On Vercel set it for
# Production and Preview, e.g. https://teslapool-backend.onrender.com (no trailing slash needed).

# Optional: hide the one-click demo logins on the login page.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
# Must match the API's AUTH_COOKIE_NAME if you changed it.
# AUTH_COOKIE_NAME=tp_session
