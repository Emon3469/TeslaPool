{
  "name": "teslapool-frontend",
  "version": "1.0.5",
  "private": true,
  "description": "TeslaPool web app: marketing site, passenger app and driver app (Next.js App Router)",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:types": "openapi-typescript ../teslapool-backend/openapi/openapi.json -o src/lib/api-types.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.48.0",
    "next": "15.5.26",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "swr": "2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.26",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "^5.5.4",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=20.18 <23"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
